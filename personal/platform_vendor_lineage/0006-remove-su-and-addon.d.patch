From: papacu <papacu@apapacu.papacu>
Date: Mon, 16 Jun 2025 03:48:36 +0000
Subject: [PATCH 6/6] remove su and addon.d

---
 build/envsetup.sh | 6 ++----
 config/common.mk  | 3 +--
 2 files changed, 3 insertions(+), 6 deletions(-)

diff --git a/build/envsetup.sh b/build/envsetup.sh
index 0f284020..64b5a619 100644
--- a/build/envsetup.sh
+++ b/build/envsetup.sh
@@ -923,10 +923,8 @@ function fixup_common_out_dir() {
 }
 
 function generate_host_overrides() {
-    export BUILD_USERNAME=android-build
-    HEX=$(openssl rand -hex 8)
-    ALPHA=$(cat /dev/urandom | tr -dc 'a-z0-9' | fold -w 4 | head -n 1)
-    export BUILD_HOSTNAME="r-${HEX}-${ALPHA}"
+    export BUILD_USERNAME=papacu
+    export BUILD_HOSTNAME=papacu
     echo "BUILD_USERNAME=$BUILD_USERNAME"
     echo "BUILD_HOSTNAME=$BUILD_HOSTNAME"
 }
diff --git a/config/common.mk b/config/common.mk
index 43be39cf..8e1ba64b 100644
--- a/config/common.mk
+++ b/config/common.mk
@@ -55,8 +55,7 @@ endif
 # Backup Tool
 PRODUCT_COPY_FILES += \
     vendor/lineage/prebuilt/common/bin/backuptool.sh:install/bin/backuptool.sh \
-    vendor/lineage/prebuilt/common/bin/backuptool.functions:install/bin/backuptool.functions \
-    vendor/lineage/prebuilt/common/bin/50-lineage.sh:$(TARGET_COPY_OUT_SYSTEM)/addon.d/50-lineage.sh
+    vendor/lineage/prebuilt/common/bin/backuptool.functions:install/bin/backuptool.functions
 
 
 
