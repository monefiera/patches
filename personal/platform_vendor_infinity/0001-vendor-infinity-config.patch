From becb947bea04c2edf4b2a07c2d569c7f03cf85d6 Mon Sep 17 00:00:00 2001
From: Papacu <viniciussadxxx@gmail.com>
Date: Mon, 2 Jun 2025 20:59:27 -0300
Subject: [PATCH] vendor infinity config

---
 build/envsetup.sh | 6 ++----
 config/common.mk  | 7 -------
 config/version.mk | 1 -
 3 files changed, 2 insertions(+), 12 deletions(-)

diff --git a/build/envsetup.sh b/build/envsetup.sh
index 755e3f0..cc39204 100644
--- a/build/envsetup.sh
+++ b/build/envsetup.sh
@@ -939,10 +939,8 @@ function fixup_common_out_dir() {
 }
 
 function generate_host_overrides() {
-    export BUILD_USERNAME=android-build
-    HEX=$(openssl rand -hex 8)
-    ALPHA=$(cat /dev/urandom | tr -dc 'a-z0-9' | fold -w 4 | head -n 1)
-    export BUILD_HOSTNAME="r-${HEX}-${ALPHA}"
+    export BUILD_USERNAME=$(whoami)
+    export BUILD_HOSTNAME=$(hostname)
     echo "BUILD_USERNAME=$BUILD_USERNAME"
     echo "BUILD_HOSTNAME=$BUILD_HOSTNAME"
 }
diff --git a/config/common.mk b/config/common.mk
index ebc7141..045032d 100644
--- a/config/common.mk
+++ b/config/common.mk
@@ -27,7 +27,6 @@ ifeq ($(TARGET_BUILD_VARIANT),eng)
 PRODUCT_SYSTEM_DEFAULT_PROPERTIES += ro.adb.secure=0
 else
 # Enable ADB authentication
-PRODUCT_SYSTEM_DEFAULT_PROPERTIES += ro.adb.secure=1
 
 # Disable extra StrictMode features on all non-engineering builds
 PRODUCT_SYSTEM_DEFAULT_PROPERTIES += persist.sys.strictmode.disable=true
@@ -312,12 +311,6 @@ PRODUCT_PACKAGES += \
 PRODUCT_PACKAGES += \
     adb_root
 
-PRODUCT_PACKAGES += \
-    su
-
-PRODUCT_ARTIFACT_PATH_REQUIREMENT_ALLOWED_LIST += \
-    system/xbin/su
-
 # Face Unlock
 TARGET_FACE_UNLOCK_SUPPORTED ?= $(TARGET_SUPPORTS_64_BIT_APPS)
 ifeq ($(TARGET_FACE_UNLOCK_SUPPORTED),true)
diff --git a/config/version.mk b/config/version.mk
index 2a5b5ae..fa75dba 100644
--- a/config/version.mk
+++ b/config/version.mk
@@ -56,6 +56,5 @@ PRODUCT_SYSTEM_DEFAULT_PROPERTIES += \
   ro.infinity.build.date=$(INFINITY_BUILD_DATE) \
   ro.infinity.buildtype=$(INFINITY_BUILD_TYPE) \
   ro.infinity.fingerprint=$(INFINITY_FINGERPRINT) \
-  ro.infinity.device=$(INFINITY_BUILD) \
   ro.infinity.version=$(INFINITYVERSION) \
   ro.infinity.maintainer=$(INFINITY_MAINTAINER)
-- 
2.49.0

